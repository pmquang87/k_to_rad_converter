# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
.eggs/
build/
dist/

# Test / lint caches
.coverage
htmlcov/
.ruff_cache/
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/

# PyCharm / IDEs
.idea/
.claude/
.vscode/

# Large Manuals / PDF Documents
*.pdf

# FEM Model files (LS-DYNA and OpenRadioss)
*.k
*.rad
*.key
*.dyn
*.inc

# Golden-file regression fixtures (override the global *.k/*.rad ignores so the
# checked-in test decks and their expected .rad outputs are tracked).
!tests/fixtures/
!tests/fixtures/**/*.k
!tests/fixtures/**/*.rad

# OS specific
.DS_Store
Thumbs.db

# Project-specific ignores
/ls-dyna_example/
/tutorial_example/
/Ryan_Lee_Examples/
/implicit_hr-anlenkung/
/demos_example/
