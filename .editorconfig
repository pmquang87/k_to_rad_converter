root = true

[*.py]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

# Docker container entrypoint shell script (no extension) — keep LF.
[orun]
end_of_line = lf
